
{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicy": "Always",
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT"
  },
  "environment": {
    "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
    "REDIS_URL": "${{Redis.REDIS_URL}}",
    "NEO4J_URI": "${{Neo4j.NEO4J_URI}}",
    "NEO4J_USER": "${{Neo4j.NEO4J_USER}}",
    "NEO4J_PASSWORD": "${{Neo4j.NEO4J_PASSWORD}}",
    "ARC_RPC_URL": "${{ARC_RPC_URL}}",
    "USDC_CONTRACT": "${{USDC_CONTRACT}}",
    "ARC_CHAIN_ID": "${{ARC_CHAIN_ID}}",
    "SECRET_KEY": "${{SECRET_KEY}}",
    "CIRCLE_TEST_API_KEY": "${{CIRCLE_TEST_API_KEY}}",
    "CIRCLE_KIT_KEY": "${{CIRCLE_KIT_KEY}}",
    "POCKET_ORACLE_ADDRESS": "${{POCKET_ORACLE_ADDRESS}}",
    "PRIVATE_KEY": "${{PRIVATE_KEY}}"
  },
  "services": [
    {
      "name": "Postgres",
      "type": "postgresql",
      "minDiskSize": 1024
    },
    {
      "name": "Redis",
      "type": "redis"
    },
    {
      "name": "Neo4j",
      "type": "neo4j"
    }
  ]
}
