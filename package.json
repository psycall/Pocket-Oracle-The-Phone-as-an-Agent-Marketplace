{
  "name": "orvion",
  "version": "2.0.0",
  "description": "ORVION - Agentic Settlement Layer",
  "private": true,
  "workspaces": [
    "packages/sdk"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "compile": "hardhat --config hardhat.config.cjs compile",
    "deploy:arc": "hardhat --config hardhat.config.cjs run scripts/deploy-secure.js --network arc-testnet",
    "deploy:pharos": "hardhat --config hardhat.config.cjs run scripts/deploy-secure.js --network pharos-testnet",
    "test": "hardhat --config hardhat.config.cjs test",
    "test:coverage": "hardhat --config hardhat.config.cjs coverage",
    "verify": "hardhat --config hardhat.config.cjs verify",
    "clean": "hardhat --config hardhat.config.cjs clean",
    "node": "hardhat --config hardhat.config.cjs node",
    "dev": "cd packages/sdk && npm run dev",
    "build": "cd packages/sdk && npm run build",
    "lint": "cd packages/sdk && npm run lint",
    "format": "cd packages/sdk && npm run format"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6"
  },
  "type": "module",
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
