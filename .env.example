# ==============================================
# ORVION — Environment Variables Template
# COPY to .env and fill real values
# NEVER commit your .env file
# ==============================================

APP_ENV=development
API_PORT=8080
API_LOG_LEVEL=debug
SECRET_KEY=generate_with_openssl_rand_hex_32

# Arc Network
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
CIRBTC_CONTRACT=0x5412177bEEB84dD86E0f0e6cc54651D5bbB4264D

# Pharos Network (CCTP v2)
PHAROS_RPC_URL=https://rpc.testnet.pharos.network
PHAROS_CHAIN_ID=808080
PHAROS_USDC_CONTRACT=0x...

# Circle Services
CIRCLE_FORWARDING_SERVICE_URL=https://api-sandbox.circle.com/v1/forwarding
CIRCLE_GATEWAY_URL=https://api-sandbox.circle.com/v1/gateway

# Circle Developer — https://console.circle.com
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here
CIRCLE_ENVIRONMENT=sandbox
CIRCLE_WALLET_SET_ID=your_wallet_set_id_here

# Smart Contracts (deploy first)
# Arc Testnet deploy: 2026-05-09 — Chain ID 5042002
SETTLEMENT_CONTRACT_ADDRESS=0x34B7d77bEEB84dD86E0f0e6cc54651D5bbB4264D
POCKET_ORACLE_ADDRESS=deploy_and_paste_here
PRIVATE_KEY=your_deployer_private_key_here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://orvion:orvion_password@localhost:5432/orvion
POSTGRES_USER=orvion
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=orvion

# Redis
REDIS_URL=redis://:change_this_password@localhost:6379/0
REDIS_PASSWORD=change_this_password

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_password
