# Orvion — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Core security ──────────────────────────────────────────────
SECRET_KEY=change-me-before-production-32+chars

# ── AI provider (optional — DEMO_MODE=true bypasses it) ────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
DEMO_MODE=true

# ── Runtime ────────────────────────────────────────────────────
NODE_ID=orvion-node-001
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379
DATABASE_URL=sqlite:///./orvion.db
RATE_LIMIT_PER_MINUTE=60
PAYMENT_MODE=mock
SENSOR_ORCHESTRATOR_URL=http://localhost:8100

# ── Frontend endpoints ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
